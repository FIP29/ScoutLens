# Local development configuration for ScoutLens.
# Copy from .env.example and adjust to match your MySQL instance.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=scoutlens
DB_PASSWORD=scoutlens
DB_NAME=scoutlens
PORT=4000

# ---------------------------------------------------------------- admin ---
# Signs admin session tokens. Must be at least 32 characters, random, and
# never committed. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Without it the admin area reports itself unconfigured; the public app is
# unaffected.
JWT_SECRET=
# How long an admin session lasts before logging in again.
JWT_EXPIRES_IN=2h
# bcrypt work factor for the admin password (clamped to 10-15).
BCRYPT_ROUNDS=12
# Failed logins allowed per 15 minutes before the login is locked.
ADMIN_LOGIN_MAX_ATTEMPTS=5
